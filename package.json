{
  "name": "mystique",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Let any coding agent shapeshift into a Neovim power user: drive a live, visible Neovim from pi or Claude Code.",
  "keywords": ["pi-package", "neovim", "mcp", "claude-code"],
  "license": "MIT",
  "repository": "github:sudoish/mystique",
  "bin": {
    "mystique": "./bin/mystique.mjs"
  },
  "pi": {
    "extensions": ["./extension/index.ts"]
  },
  "scripts": {
    "doctor": "node bin/mystique.mjs doctor",
    "test": "node --test bin/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "neovim": "^5.5.0",
    "tsx": "^4.23.15",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  }
}
